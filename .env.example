# Copy to .env (gitignored) and fill in. Never commit .env or the .p8 key.
# How to get each value: README.md → "Gather the credentials".

# App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys
ASC_KEY_ID=
# Shown above the Team Keys table ("Issuer ID"). Leave empty only for an individual key.
ASC_ISSUER_ID=
# team (default) | individual
ASC_KEY_TYPE=team

# Optional — default lookup: ./secrets/AuthKey_<ASC_KEY_ID>.p8, then ~/.appstoreconnect/private_keys/
ASC_PRIVATE_KEY_PATH=

# Numeric Apple ID of the app (App Information → Apple ID, or `asc_fetch.py apps`)
ASC_APP_ID=

# Only for Sales reports: Payments and Financial Reports → vendor number (top left)
ASC_VENDOR_NUMBER=
